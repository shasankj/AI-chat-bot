# Copy to backend/.env and fill in. NEVER commit the real file (it is git-ignored).

# Restricted role used by the chatbot, retriever and MCP server (SELECT; INSERT only on hc_audit_log)
DATABASE_URL=postgresql+psycopg://APP_ROLE:PASSWORD@HOST:5432/DBNAME?sslmode=require

# Owner role: used ONLY by setup scripts (run_sql, ingest). The running app never uses it.
OWNER_DATABASE_URL=postgresql+psycopg://OWNER_ROLE:PASSWORD@HOST:5432/DBNAME?sslmode=require

ANTHROPIC_API_KEY=sk-ant-...
LLM_MODEL=claude-haiku-4-5-20251001

# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# If unset, a random secret is created at startup and everyone is logged out on every restart.
SESSION_SECRET=

# Optional
# SESSION_HOURS=8
# COOKIE_SECURE=true                      # set when serving over HTTPS
# CORS_ORIGINS=http://localhost:5173
